<MudPaper Class="pa-2 mb-4" Elevation="1">
    <MudText Typo="Typo.subtitle1" Class="px-2">@Title</MudText>
    <MudSimpleTable Dense="true" Hover="true">
        <thead><tr><th>Season</th><th>Game</th><th>Matchup</th><th class="num">Score</th></tr></thead>
        <tbody>
            @foreach (var m in Meetings)
            {
                @* Striped in the winner's color; ties get a neutral stripe. *@
                <tr class="season-row" style="@($"--row-team:{(m.Winner is { } w ? Teams.GetValueOrDefault(w)?.PrimaryColor ?? "#888888" : "#9e9e9e")}")">
                    <td>@m.Season</td>
                    <td>@(m.GameType == GameTypes.Regular ? $"Week {m.Week}" : m.GameType)</td>
                    <td>
                        <TeamBadge Id="@m.AwayTeam" Team="@Teams.GetValueOrDefault(m.AwayTeam)" />
                        <span class="muted">@(m.NeutralSite ? " vs " : " @ ")</span>
                        <TeamBadge Id="@m.HomeTeam" Team="@Teams.GetValueOrDefault(m.HomeTeam)" />
                    </td>
                    <td class="num">
                        <span class="@(m.Winner == m.AwayTeam ? "winner" : null)">@m.AwayScore</span>-<span class="@(m.Winner == m.HomeTeam ? "winner" : null)">@m.HomeScore</span>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public IReadOnlyList<Meeting> Meetings { get; set; } = [];

    [Parameter, EditorRequired] public Dictionary<string, TeamInfo> Teams { get; set; } = [];
}
