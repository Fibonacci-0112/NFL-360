@page "/"

<PageTitle>NFL 360 Coverage</PageTitle>

<section class="hero">
    <div class="hero-content">
        <span class="eyebrow">Every team · every tiebreaker · every scenario</span>
        <h1>The whole league,<br /><span>all 360 degrees.</span></h1>
        <p>
            Standings with every official tiebreaker applied, playoff probabilities from thousands of simulated seasons,
            and a what-if simulator that runs in your browser.
        </p>
        <div class="hero-actions">
            <MudButton Href="/playoffs/odds" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large">Playoff odds</MudButton>
            <MudButton Href="/playoffs/what-if" Variant="Variant.Outlined" Size="Size.Large" Class="hero-outline">Play what-if</MudButton>
        </div>
    </div>
</section>

<LiveScoreboard @rendermode="InteractiveServer" />

<MudText Typo="Typo.h5" Class="section-title mt-10 mb-4">Explore</MudText>

<div class="feature-grid">
    @foreach (var feature in Features)
    {
        <a class="feature-card" href="@feature.Href" style="--accent:@feature.Accent">
            <span class="feature-icon"><MudIcon Icon="@feature.Icon" /></span>
            <span class="feature-title">@feature.Title</span>
            <span class="feature-text">@feature.Text</span>
            <span class="feature-cta">@feature.Cta <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></span>
        </a>
    }
</div>

@code {
    private sealed record Feature(string Title, string Text, string Cta, string Href, string Icon, string Accent);

    private static readonly Feature[] Features =
    [
        new("Standings", "Division and conference tables with seeds and the tiebreak that decided each tie.",
            "View standings", "/standings", Icons.Material.Filled.FormatListNumbered, "var(--nfl-accent)"),
        new("Playoff odds", "Chances to make the playoffs, win the division, earn the bye and win it all — and how they moved week to week.",
            "View odds", "/playoffs/odds", Icons.Material.Filled.Insights, "#D50A0A"),
        new("What-if simulator", "Pick winners of upcoming games and watch the playoff picture change instantly.",
            "Open simulator", "/playoffs/what-if", Icons.Material.Filled.Tune, "#E8A317"),
        new("Player stats", "Leaderboards for every season since 1999, career pages and game logs for every player.",
            "View leaders", "/stats/players", Icons.Material.Filled.SportsFootball, "#1B7F4B"),
        new("Team efficiency", "Offense and defense compared by expected points added per play, the best single measure of team quality.",
            "Compare teams", "/stats/teams", Icons.Material.Filled.Speed, "#6A3FB5"),
        new("History", "Super Bowl champions, every franchise season by season, and head-to-head series between any two teams.",
            "Explore history", "/history", Icons.Material.Filled.EmojiEvents, "#B8860B"),
    ];
}
